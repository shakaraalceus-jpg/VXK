```css
/* =========================================================
   VXK ADVISORY
   Minimalist Forest Green / Gray Design
========================================================= */

:root {
  --green: #0e3a0e;
  --green-light: #eaf1ea;
  --green-mid: #315d31;

  --gray-dark: #242424;
  --gray: #5d5d5d;
  --gray-light: #777;
  --border: #dedede;

  --white: #ffffff;
  --off-white: #f7f8f6;

  --max-width: 1180px;
}


/* =========================================================
   RESET
========================================================= */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color: var(--gray-dark);
  background: var(--white);
  line-height: 1.65;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
}

.container {
  width: min(var(--max-width), 86vw);
  margin: 0 auto;
}


/* =========================================================
   TYPOGRAPHY
========================================================= */

h1,
h2,
h3,
h4 {
  margin-top: 0;
  color: var(--gray-dark);
  line-height: 1.12;
}

h1 {
  font-size: clamp(3rem, 6vw, 6.2rem);
  letter-spacing: -0.045em;
  max-width: 950px;
}

h2 {
  font-size: clamp(2.2rem, 4vw, 3.6rem);
  letter-spacing: -0.035em;
}

h3 {
  font-size: 1.4rem;
}

p {
  color: var(--gray);
}

.eyebrow {
  margin: 0 0 14px;
  color: var(--green);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.17em;
}

.large-text {
  font-size: 1.35rem;
  line-height: 1.6;
}


/* =========================================================
   NAVIGATION
========================================================= */

.site-header {
  background: var(--white);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav {
  min-height: 78px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
}

.logo-main {
  color: var(--green);
  font-size: 1.35rem;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.logo-sub {
  color: var(--gray);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 25px;
}

.nav-links a {
  color: var(--gray);
  text-decoration: none;
  font-size: 0.9rem;
}

.nav-links a:hover {
  color: var(--green);
}


/* =========================================================
   HERO
========================================================= */

.hero {
  background: var(--off-white);
  padding: 100px 0 110px;
  border-bottom: 1px solid var(--border);
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.35fr 0.65fr;
  gap: 80px;
  align-items: center;
}

.hero h1 {
  margin-bottom: 28px;
}

.hero h1 span {
  color: var(--green);
}

.hero-text {
  max-width: 750px;
  font-size: 1.2rem;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 32px;
}


/* =========================================================
   BUTTONS
========================================================= */

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 48px;
  padding: 12px 20px;

  border-radius: 5px;

  font-weight: 750;
  text-decoration: none;

  transition:
    transform 0.2s ease,
    background 0.2s ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button.primary {
  background: var(--green);
  color: var(--white);
}

.button.primary:hover {
  background: #092b09;
}

.button.secondary {
  background: var(--white);
  color: var(--green);
  border: 1px solid var(--green);
}

.full-width {
  width: 100%;
  border: 0;
  cursor: pointer;
  font: inherit;
}


/* =========================================================
   HERO METHOD CARD
========================================================= */

.hero-card {
  background: var(--white);
  border: 1px solid var(--border);
  padding: 32px;
}

.method-stack {
  display: grid;
  gap: 0;
}

.method-item {
  display: grid;
  grid-template-columns: 35px 1fr;
  column-gap: 10px;

  padding: 18px 0;
  border-bottom: 1px solid var(--border);
}

.method-item:last-child {
  border-bottom: 0;
}

.method-item span {
  grid-row: span 2;
  color: var(--green);
  font-size: 0.75rem;
  font-weight: 800;
}

.method-item strong {
  color: var(--gray-dark);
}

.method-item p {
  margin: 3px 0 0;
  font-size: 0.88rem;
}


/* =========================================================
   SECTIONS
========================================================= */

.section {
  padding: 110px 0;
}

.light-section {
  background: var(--off-white);
}

.narrow {
  max-width: 850px;
}

.section-heading {
  max-width: 850px;
  margin-bottom: 55px;
}

.section-heading p:last-child {
  max-width: 700px;
}


/* =========================================================
   POSITIONING
========================================================= */

.positioning {
  padding-top: 120px;
  padding-bottom: 120px;
}


/* =========================================================
   SERVICES
========================================================= */

.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.service-card {
  background: var(--white);
  border: 1px solid var(--border);
  padding: 32px;
}

.featured-service {
  border: 2px solid var(--green);
}

.service-number {
  display: block;
  margin-bottom: 28px;
  color: var(--green);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.15em;
}

.service-description {
  min-height: 105px;
}

.service-card h4 {
  margin-top: 30px;
  margin-bottom: 12px;
  font-size: 0.75rem;
  color: var(--green);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.service-card ul {
  padding-left: 18px;
  margin-bottom: 0;
}

.service-card li {
  margin-bottom: 8px;
  color: var(--gray);
}


/* =========================================================
   PROCESS
========================================================= */

.process-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
}

.process-card {
  background: var(--white);
  padding: 30px;
}

.process-card span {
  color: var(--green);
  font-size: 0.75rem;
  font-weight: 800;
}

.process-card h3 {
  margin-top: 25px;
}

.client-journey {
  margin-top: 65px;
}

.journey {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
}

.journey span {
  padding: 10px 14px;
  background: var(--green-light);
  color: var(--green);
  font-size: 0.85rem;
  font-weight: 700;
}

.journey b {
  color: var(--gray-light);
}


/* =========================================================
   DARK SECTION
========================================================= */

.dark-section {
  background: var(--green);
}

.dark-section h2,
.dark-section h3 {
  color: var(--white);
}

.light-heading .eyebrow,
.dark-section .eyebrow {
  color: #b9d2b9;
}

.dark-section p {
  color: #d8e2d8;
}

.industry-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: rgba(255,255,255,0.2);
}

.industry-item {
  background: var(--green);
  padding: 30px;
  border: 1px solid rgba(255,255,255,0.08);
}

.industry-item span {
  color: #b9d2b9;
  font-size: 0.75rem;
  font-weight: 800;
}


/* =========================================================
   PROBLEM AREAS
========================================================= */

.problem-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 20px;
}

.problem-grid article {
  padding-top: 25px;
  border-top: 2px solid var(--green);
}

.problem-grid span {
  color: var(--green);
  font-size: 0.7rem;
  font-weight: 850;
  letter-spacing: 0.12em;
}


/* =========================================================
   PROFESSIONAL PORTFOLIO
========================================================= */

.portfolio-columns {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.portfolio-block {
  background: var(--white);
  border: 1px solid var(--border);
  padding: 35px;
}

.skill-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 28px;
}

.skill-list span {
  border: 1px solid var(--border);
  padding: 7px 11px;
  font-size: 0.8rem;
  color: var(--gray);
}


/* =========================================================
   CASE STUDY
========================================================= */

.case-placeholder {
  margin-top: 30px;
  padding: 25px;
  background: var(--off-white);
  border: 1px dashed #c8c8c8;
}

.case-placeholder span {
  display: block;
  color: var(--green);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  margin-bottom: 8px;
}

.case-placeholder strong {
  color: var(--gray-dark);
}


/* =========================================================
   BELLABEAT PROJECT
========================================================= */

.project-feature {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  border: 1px solid var(--border);
}

.project-info,
.project-findings {
  padding: 40px;
}

.project-findings {
  background: var(--off-white);
  border-left: 1px solid var(--border);
}

.project-tag {
  display: inline-block;
  margin-bottom: 25px;
  color: var(--green);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.project-info h3 {
  font-size: 2rem;
  margin-bottom: 20px;
}

.project-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  margin-top: 35px;
}

.project-stats div {
  padding-top: 15px;
  border-top: 1px solid var(--border);
}

.project-stats strong {
  display: block;
  color: var(--green);
  font-size: 1.6rem;
}

.project-stats span {
  color: var(--gray);
  font-size: 0.78rem;
}

.finding {
  display: grid;
  grid-template-columns: 35px 1fr;
  gap: 10px;
  border-bottom: 1px solid var(--border);
  padding: 18px 0;
}

.finding:last-child {
  border-bottom: 0;
}

.finding strong {
  color: var(--green);
  font-size: 0.75rem;
}

.finding p {
  margin: 0;
}

.project-disclaimer {
  margin-top: 20px;
  padding: 18px;
  background: var(--green-light);
  font-size: 0.85rem;
  color: var(--gray);
}


/* =========================================================
   ABOUT
========================================================= */

.about-section {
  background: var(--off-white);
}

.about-grid {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 100px;
}

.about-copy {
  max-width: 700px;
}


/* =========================================================
   FOUNDER
========================================================= */

.founder-grid {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 100px;
}

.founder-title {
  color: var(--green);
  font-weight: 700;
}

.text-link {
  color: var(--green);
  font-weight: 750;
  text-decoration: none;
}

.text-link:hover {
  text-decoration: underline;
}


/* =========================================================
   CONTACT
========================================================= */

.contact-section {
  background: var(--off-white);
}

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 90px;
}

.contact-details {
  margin-top: 40px;
}

.contact-details p {
  margin-bottom: 25px;
}

.contact-details strong {
  color: var(--gray-dark);
}

.contact-details a {
  color: var(--green);
  text-decoration: none;
}

.contact-form-card {
  background: var(--white);
  border: 1px solid var(--border);
  padding: 35px;
}

.form-group {
  margin-bottom: 20px;
}

.form-group label {
  display: block;
  margin-bottom: 7px;
  color: var(--gray-dark);
  font-size: 0.82rem;
  font-weight: 700;
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  border: 1px solid #cccccc;
  border-radius: 4px;
  padding: 13px 14px;

  background: var(--white);

  color: var(--gray-dark);
  font: inherit;

  outline: none;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  border-color: var(--green);
}

.form-group textarea {
  resize: vertical;
}


/* =========================================================
   FOOTER
========================================================= */

.footer {
  background: var(--gray-dark);
  color: var(--white);
  padding: 55px 0 25px;
}

.footer-content {
  display: flex;
  justify-content: space-between;
  gap: 40px;
}

.footer strong {
  letter-spacing: 0.12em;
}

.footer p {
  color: #bcbcbc;
  font-size: 0.85rem;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
}

.footer-links a {
  color: #d7d7d7;
  text-decoration: none;
  font-size: 0.85rem;
}

.footer-bottom {
  width: min(var(--max-width), 86vw);
  margin: 45px auto 0;
  padding-top: 20px;
  border-top: 1px solid #444;
  display: flex;
  justify-content: space-between;
  gap: 20px;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 900px) {

  .nav-links {
    display: none;
  }

  .hero {
    padding: 75px 0;
  }

  .hero-grid,
  .about-grid,
  .founder-grid,
  .contact-grid,
  .project-feature {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .project-findings {
    border-left: 0;
    border-top: 1px solid var(--border);
  }

  .service-grid,
  .industry-grid,
  .process-grid {
    grid-template-columns: 1fr;
  }

  .problem-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .portfolio-columns {
    grid-template-columns: 1fr;
  }

  .footer-content,
  .footer-bottom {
    flex-direction: column;
  }

}


@media (max-width: 600px) {

  .container {
    width: 90vw;
  }

  .section {
    padding: 75px 0;
  }

  h1 {
    font-size: 3rem;
  }

  h2 {
    font-size: 2.2rem;
  }

  .hero-actions {
    flex-direction: column;
  }

  .hero-actions .button {
    width: 100%;
  }

  .problem-grid {
    grid-template-columns: 1fr;
  }

  .project-stats {
    grid-template-columns: 1fr;
  }

  .contact-form-card {
    padding: 25px;
  }

}
```
